<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Keep the app database and user covers. The DataStore mixes
         settings with credentials; GitHub auth also uses device keystore keys.
         File caches, crash logs and future files are excluded by this allowlist. -->
    <include domain="database" path="." />
    <include domain="file" path="covers/" />
    <include domain="file" path="epub_covers/" />
    <exclude domain="file" path="datastore/" />
    <exclude domain="sharedpref" path="github_auth.xml" />
</full-backup-content>
