<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Only durable library data and user covers travel. The DataStore mixes
             settings with credentials; GitHub auth also uses device keystore keys.
             Cache, downloads, logs and future files are excluded by this allowlist. -->
        <include domain="database" path="." />
        <include domain="file" path="covers/" />
        <include domain="file" path="epub_covers/" />
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="github_auth.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Only durable library data and user covers travel. The DataStore mixes
             settings with credentials; GitHub auth also uses device keystore keys.
             Cache, downloads, logs and future files are excluded by this allowlist. -->
        <include domain="database" path="." />
        <include domain="file" path="covers/" />
        <include domain="file" path="epub_covers/" />
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="github_auth.xml" />
    </device-transfer>
</data-extraction-rules>
