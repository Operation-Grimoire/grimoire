    <string name="tour_start">ابدأ</string>
    <string name="tour_progress">%1$d/%2$d</string>
    <string name="tour_welcome_title">جولة الترحيب</string>
    <string name="tour_welcome_description">الأساسيات: المكتبة والتصفّح والمصادر والإعدادات.</string>
    <string name="tour_step_welcome_title">مرحبًا بك في Grimoire</string>
    <string name="tour_step_welcome_body">جولة سريعة على الأساسيات — تستغرق نحو 20 ثانية.</string>
    <string name="tour_step_library_title">مكتبتك</string>
    <string name="tour_step_library_body">الروايات التي تضيفها تُحفظ هنا، مرتبة في فئات.</string>
    <string name="tour_step_browse_title">تصفّح</string>
    <string name="tour_step_browse_body">انقر على «تصفّح» للعثور على روايات من مصادرك.</string>
    <string name="tour_step_extensions_title">المصادر والإضافات</string>
    <string name="tour_step_extensions_body">تُثبَّت المصادر من هنا. افتحها لترى ما هو متاح.</string>
    <string name="tour_open_extensions">فتح الإضافات</string>
    <string name="tour_step_repositories_title">المستودعات</string>
    <string name="tour_step_repositories_body">تأتي المصادر من المستودعات. المستودع الرسمي مضاف بالفعل — انقر هنا لإدارتها أو لإضافة مستودعك الخاص.</string>
    <string name="tour_step_more_title">كل شيء آخر</string>
    <string name="tour_step_more_body">التنزيلات والإحصاءات والنسخ الاحتياطية والإعدادات موجودة ضمن «المزيد».</string>
    <string name="tour_step_done_title">أنت جاهز تمامًا</string>
    <string name="tour_step_done_body">أعد تشغيل أي جولة من المزيد ← الجولات.</string>
    <string name="tour_library_title">جولة المكتبة</string>
    <string name="tour_library_description">البحث والتصفية والفئات والإجراءات الجماعية.</string>
    <string name="tour_step_library_find_title">البحث والتصفية</string>
    <string name="tour_step_library_find_body">ابحث في مكتبتك، أو رتّبها وصفِّها حسب الحالة والمصدر والتقييم وغير ذلك.</string>
    <string name="tour_step_library_refresh_title">التحقق من الفصول الجديدة</string>
    <string name="tour_step_library_refresh_body">حدّث المكتبة كلها، أو الفئة التي تعرضها فقط.</string>
    <string name="tour_step_library_menu_title">الفئات والاستيراد</string>
    <string name="tour_step_library_menu_body">أنشئ الفئات من هنا، ثم اسحب للتنقّل بينها. يمكنك أيضًا استيراد ملفات EPUB.</string>
    <string name="tour_step_library_select_title">تحديد عدة روايات</string>
    <string name="tour_step_library_select_body">اضغط مطولًا على رواية لبدء التحديد، ثم انقلها أو نزّلها أو أزلها كلها دفعة واحدة.</string>
    <string name="tour_browse_title">جولة التصفّح</string>
    <string name="tour_browse_description">المصادر والبحث الشامل والمرشّحات وNovelUpdates.</string>
    <string name="tour_step_browse_sources_title">مصادرك</string>
    <string name="tour_step_browse_sources_body">تظهر المصادر المثبّتة هنا مرتبة حسب اللغة. انقر على أحدها لتصفّحه، أو اضغط مطولًا لتثبيته أو إلغاء تثبيته.</string>
    <string name="tour_step_browse_search_title">البحث في كل مكان</string>
    <string name="tour_step_browse_search_body">ابحث في جميع مصادرك دفعة واحدة.</string>
    <string name="tour_step_browse_filter_title">تصفية المصادر</string>
    <string name="tour_step_browse_filter_body">ضيّق القائمة حسب الاسم أو اللغة.</string>
    <string name="tour_step_browse_novelupdates_title">NovelUpdates</string>
    <string name="tour_step_browse_novelupdates_body">اكتشف الروايات عبر تصنيفات NovelUpdates وأحدث الإصدارات والبحث. يمكنك إخفاء هذا القسم من إعدادات التصفّح.</string>
    <string name="tour_step_browse_extensions_title">إدارة الإضافات</string>
    <string name="tour_step_browse_extensions_body">ثبّت المصادر وحدّثها وأزلها. تظهر شارة هنا عندما تتوفر تحديثات.</string>
    <string name="tour_novel_title">جولة صفحة الرواية</string>
    <string name="tour_novel_description">مكتبتك وتنبيهات الفصول الجديدة والتنزيلات وأدوات الفصول.</string>
    <string name="tour_novel_hint">تبدأ في المرة القادمة التي تفتح فيها رواية</string>
    <string name="tour_step_novel_library_title">إضافة إلى المكتبة</string>
    <string name="tour_step_novel_library_body">احتفظ بهذه الرواية في مكتبتك لمتابعة الفصول الجديدة وتقدّمك في القراءة.</string>
    <string name="tour_step_novel_notifications_title">الفصول الجديدة</string>
    <string name="tour_step_novel_notifications_body">للروايات في مكتبتك، اختر هل تُعلمك الفصول الجديدة أم تُنزَّل تلقائيًا.</string>
    <string name="tour_step_novel_downloads_title">القراءة دون اتصال</string>
    <string name="tour_step_novel_downloads_body">نزّل الفصول لقراءتها دون اتصال بالإنترنت.</string>
    <string name="tour_step_novel_chapters_title">أدوات الفصول</string>
    <string name="tour_step_novel_chapters_body">ابحث في قائمة الفصول ورتّبها. انقر على عدد الفصول للانتقال إلى فصل، أو اضغط مطولًا على الفصول لتحديد عدة فصول.</string>
    <string name="tour_step_novel_read_title">ابدأ القراءة</string>
    <string name="tour_step_novel_read_body">ابدأ من الفصل الأول، أو تابع من حيث توقفت تمامًا.</string>
    <string name="tour_reader_title">جولة القارئ</string>
    <string name="tour_reader_description">عناصر تحكم القارئ والمظهر والقراءة بصوت عالٍ.</string>
    <string name="tour_reader_hint">تبدأ في المرة القادمة التي تفتح فيها فصلًا</string>
    <string name="tour_step_reader_tap_title">إظهار عناصر التحكم</string>
    <string name="tour_step_reader_tap_body">انقر على الصفحة لإظهار عناصر تحكم القارئ أو إخفائها. جرّب ذلك الآن.</string>
    <string name="tour_step_reader_settings_title">اجعله على ذوقك</string>
    <string name="tour_step_reader_settings_body">غيّر الخط وحجم النص والتباعد والألوان وغير ذلك.</string>
    <string name="tour_step_reader_read_aloud_title">القراءة بصوت عالٍ</string>
    <string name="tour_step_reader_read_aloud_body">استمع إلى الفصل عبر تحويل النص إلى كلام.</string>
    <string name="tour_step_reader_chapters_title">الفصل التالي</string>
    <string name="tour_step_reader_chapters_body">انتقل إلى الفصل التالي من هنا، أو ارجع بالزر الموجود في الطرف الآخر.</string>
    <string name="tour_step_reader_mark_read_title">تعليم كمقروء</string>
    <string name="tour_step_reader_mark_read_body">علّم هذا الفصل كمقروء أو غير مقروء.</string>
    <string name="tour_step_reader_webview_title">الصفحة الأصلية</string>
    <string name="tour_step_reader_webview_body">افتح الفصل على موقع المصدر — مفيد لتسجيل الدخول أو اختبارات captcha أو فصل لم يُحمَّل.</string>

