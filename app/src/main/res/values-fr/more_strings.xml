    <!-- Tours and shared tour overlay -->
    <string name="tour_start">Commencer</string>
    <string name="tour_progress">%1$d/%2$d</string>
    <string name="tour_welcome_title">Visite de bienvenue</string>
    <string name="tour_welcome_description">L’essentiel : bibliothèque, navigation, sources et paramètres.</string>
    <string name="tour_step_welcome_title">Bienvenue dans Grimoire</string>
    <string name="tour_step_welcome_body">Un petit tour de l’essentiel — environ 20 secondes.</string>
    <string name="tour_step_library_title">Votre bibliothèque</string>
    <string name="tour_step_library_body">Les romans que vous ajoutez se trouvent ici, rangés par catégories.</string>
    <string name="tour_step_browse_title">Parcourir</string>
    <string name="tour_step_browse_body">Appuyez sur Parcourir pour trouver des romans dans vos sources.</string>
    <string name="tour_step_extensions_title">Sources et extensions</string>
    <string name="tour_step_extensions_body">Les sources s’installent ici. Ouvrez cet écran pour voir ce qui est disponible.</string>
    <string name="tour_open_extensions">Ouvrir les extensions</string>
    <string name="tour_step_repositories_title">Dépôts</string>
    <string name="tour_step_repositories_body">Les sources proviennent de dépôts. Le dépôt officiel est déjà ajouté — appuyez ici pour les gérer ou ajouter le vôtre.</string>
    <string name="tour_step_more_title">Tout le reste</string>
    <string name="tour_step_more_body">Les téléchargements, statistiques, sauvegardes et paramètres se trouvent dans Plus.</string>
    <string name="tour_step_done_title">Tout est prêt</string>
    <string name="tour_step_done_body">Revoyez une visite à tout moment depuis Plus → Visites guidées.</string>
    <string name="tour_library_title">Visite de la bibliothèque</string>
    <string name="tour_library_description">Recherche, filtres, catégories et actions groupées.</string>
    <string name="tour_step_library_find_title">Rechercher et filtrer</string>
    <string name="tour_step_library_find_body">Recherchez dans votre bibliothèque, ou triez-la et filtrez-la par statut, source, note et plus encore.</string>
    <string name="tour_step_library_refresh_title">Nouveaux chapitres</string>
    <string name="tour_step_library_refresh_body">Actualisez toute la bibliothèque, ou seulement la catégorie affichée.</string>
    <string name="tour_step_library_menu_title">Catégories et imports</string>
    <string name="tour_step_library_menu_body">Créez des catégories ici, puis balayez pour passer de l’une à l’autre. Vous pouvez aussi importer des fichiers EPUB.</string>
    <string name="tour_step_library_select_title">Sélection multiple</string>
    <string name="tour_step_library_select_body">Appuyez de manière prolongée sur un roman pour commencer la sélection, puis déplacez, téléchargez ou supprimez-les tous d’un coup.</string>
    <string name="tour_browse_title">Visite de Parcourir</string>
    <string name="tour_browse_description">Sources, recherche globale, filtres et NovelUpdates.</string>
    <string name="tour_step_browse_sources_title">Vos sources</string>
    <string name="tour_step_browse_sources_body">Les sources installées sont listées ici par langue. Appuyez sur l’une d’elles pour la parcourir ; appui prolongé pour l’épingler ou la désinstaller.</string>
    <string name="tour_step_browse_search_title">Rechercher partout</string>
    <string name="tour_step_browse_search_body">Recherchez dans toutes vos sources à la fois.</string>
    <string name="tour_step_browse_filter_title">Filtrer les sources</string>
    <string name="tour_step_browse_filter_body">Affinez la liste par nom ou par langue.</string>
    <string name="tour_step_browse_novelupdates_title">NovelUpdates</string>
    <string name="tour_step_browse_novelupdates_body">Découvrez des romans grâce aux classements, aux dernières parutions et à la recherche de NovelUpdates. Vous pouvez masquer cette section dans les paramètres de Parcourir.</string>
    <string name="tour_step_browse_extensions_title">Gérer les extensions</string>
    <string name="tour_step_browse_extensions_body">Installez, mettez à jour et supprimez des sources. Un badge apparaît ici quand des mises à jour sont prêtes.</string>
    <string name="tour_novel_title">Visite de la page du roman</string>
    <string name="tour_novel_description">Votre bibliothèque, alertes de nouveaux chapitres, téléchargements et outils de chapitres.</string>
    <string name="tour_novel_hint">Démarre la prochaine fois que vous ouvrez un roman</string>
    <string name="tour_step_novel_library_title">Ajouter à la bibliothèque</string>
    <string name="tour_step_novel_library_body">Gardez ce roman dans votre bibliothèque pour suivre les nouveaux chapitres et votre progression.</string>
    <string name="tour_step_novel_notifications_title">Nouveaux chapitres</string>
    <string name="tour_step_novel_notifications_body">Pour les romans de votre bibliothèque, choisissez si les nouveaux chapitres vous sont notifiés ou téléchargés automatiquement.</string>
    <string name="tour_step_novel_downloads_title">Lire hors ligne</string>
    <string name="tour_step_novel_downloads_body">Téléchargez des chapitres pour les lire sans connexion.</string>
    <string name="tour_step_novel_chapters_title">Outils de chapitres</string>
    <string name="tour_step_novel_chapters_body">Recherchez et triez la liste des chapitres. Appuyez sur le nombre de chapitres pour aller à l’un d’eux, ou appuyez longuement sur des chapitres pour en sélectionner plusieurs.</string>
    <string name="tour_step_novel_read_title">Commencer la lecture</string>
    <string name="tour_step_novel_read_body">Commencez au premier chapitre, ou reprenez exactement là où vous vous étiez arrêté.</string>
    <string name="tour_reader_title">Visite du lecteur</string>
    <string name="tour_reader_description">Commandes du lecteur, apparence et lecture à voix haute.</string>
    <string name="tour_reader_hint">Démarre la prochaine fois que vous ouvrez un chapitre</string>
    <string name="tour_step_reader_tap_title">Afficher les commandes</string>
    <string name="tour_step_reader_tap_body">Appuyez sur la page pour afficher ou masquer les commandes du lecteur. Essayez maintenant.</string>
    <string name="tour_step_reader_settings_title">À votre goût</string>
    <string name="tour_step_reader_settings_body">Changez la police, la taille du texte, l’espacement, les couleurs et plus encore.</string>
    <string name="tour_step_reader_read_aloud_title">Lire à voix haute</string>
    <string name="tour_step_reader_read_aloud_body">Écoutez le chapitre grâce à la synthèse vocale.</string>
    <string name="tour_step_reader_chapters_title">Chapitre suivant</string>
    <string name="tour_step_reader_chapters_body">Passez au chapitre suivant ici, ou revenez en arrière avec le bouton à l’autre extrémité.</string>
    <string name="tour_step_reader_mark_read_title">Marquer comme lu</string>
    <string name="tour_step_reader_mark_read_body">Marquez ce chapitre comme lu ou non lu.</string>
    <string name="tour_step_reader_webview_title">Page d’origine</string>
    <string name="tour_step_reader_webview_body">Ouvrez le chapitre sur le site de la source — pratique pour les connexions, les captchas ou un chapitre qui ne s’est pas chargé.</string>

