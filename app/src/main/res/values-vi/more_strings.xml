    <string name="tour_start">Bắt đầu</string>
    <string name="tour_progress">%1$d/%2$d</string>
    <string name="tour_welcome_title">Hướng dẫn chào mừng</string>
    <string name="tour_welcome_description">Những điều cơ bản: thư viện, duyệt truyện, nguồn và cài đặt.</string>
    <string name="tour_step_welcome_title">Chào mừng đến với Grimoire</string>
    <string name="tour_step_welcome_body">Hướng dẫn nhanh những điều cơ bản — chỉ mất khoảng 20 giây.</string>
    <string name="tour_step_library_title">Thư viện của bạn</string>
    <string name="tour_step_library_body">Truyện bạn thêm sẽ nằm ở đây, được sắp xếp theo danh mục.</string>
    <string name="tour_step_browse_title">Duyệt</string>
    <string name="tour_step_browse_body">Chạm vào Duyệt để tìm truyện trên các nguồn của bạn.</string>
    <string name="tour_step_extensions_title">Nguồn &amp; tiện ích</string>
    <string name="tour_step_extensions_body">Cài nguồn từ đây. Mở ra để xem những gì có sẵn.</string>
    <string name="tour_open_extensions">Mở tiện ích</string>
    <string name="tour_step_repositories_title">Kho tiện ích</string>
    <string name="tour_step_repositories_body">Nguồn đến từ các kho. Kho chính thức đã được thêm sẵn — chạm vào đây để quản lý hoặc thêm kho của riêng bạn.</string>
    <string name="tour_step_more_title">Mọi thứ khác</string>
    <string name="tour_step_more_body">Tải xuống, thống kê, sao lưu và cài đặt nằm trong mục Thêm.</string>
    <string name="tour_step_done_title">Bạn đã sẵn sàng</string>
    <string name="tour_step_done_body">Xem lại bất kỳ hướng dẫn nào trong Thêm → Hướng dẫn.</string>
    <string name="tour_library_title">Hướng dẫn thư viện</string>
    <string name="tour_library_description">Tìm kiếm, lọc, danh mục và thao tác hàng loạt.</string>
    <string name="tour_step_library_find_title">Tìm và lọc</string>
    <string name="tour_step_library_find_body">Tìm trong thư viện, hoặc sắp xếp và lọc theo trạng thái, nguồn, đánh giá và nhiều hơn nữa.</string>
    <string name="tour_step_library_refresh_title">Kiểm tra chương mới</string>
    <string name="tour_step_library_refresh_body">Làm mới toàn bộ thư viện, hoặc chỉ danh mục bạn đang xem.</string>
    <string name="tour_step_library_menu_title">Danh mục &amp; nhập</string>
    <string name="tour_step_library_menu_body">Tạo danh mục tại đây, rồi vuốt để chuyển giữa chúng. Bạn cũng có thể nhập tệp EPUB.</string>
    <string name="tour_step_library_select_title">Chọn nhiều</string>
    <string name="tour_step_library_select_body">Nhấn giữ một truyện để bắt đầu chọn, rồi di chuyển, tải xuống hoặc xóa tất cả cùng lúc.</string>
    <string name="tour_browse_title">Hướng dẫn Duyệt</string>
    <string name="tour_browse_description">Nguồn, tìm kiếm toàn cục, bộ lọc và NovelUpdates.</string>
    <string name="tour_step_browse_sources_title">Nguồn của bạn</string>
    <string name="tour_step_browse_sources_body">Các nguồn đã cài được liệt kê ở đây theo ngôn ngữ. Chạm để duyệt; nhấn giữ để ghim hoặc gỡ cài đặt.</string>
    <string name="tour_step_browse_search_title">Tìm kiếm mọi nơi</string>
    <string name="tour_step_browse_search_body">Tìm trên tất cả nguồn cùng lúc.</string>
    <string name="tour_step_browse_filter_title">Lọc nguồn</string>
    <string name="tour_step_browse_filter_body">Thu hẹp danh sách theo tên hoặc ngôn ngữ.</string>
    <string name="tour_step_browse_novelupdates_title">NovelUpdates</string>
    <string name="tour_step_browse_novelupdates_body">Khám phá truyện qua bảng xếp hạng, bản phát hành mới nhất và tìm kiếm của NovelUpdates. Bạn có thể ẩn mục này trong cài đặt Duyệt.</string>
    <string name="tour_step_browse_extensions_title">Quản lý tiện ích</string>
    <string name="tour_step_browse_extensions_body">Cài đặt, cập nhật và gỡ nguồn. Huy hiệu sẽ hiện ở đây khi có bản cập nhật.</string>
    <string name="tour_novel_title">Hướng dẫn trang truyện</string>
    <string name="tour_novel_description">Thư viện, thông báo chương mới, tải xuống và công cụ chương.</string>
    <string name="tour_novel_hint">Bắt đầu vào lần tới bạn mở một truyện</string>
    <string name="tour_step_novel_library_title">Thêm vào thư viện</string>
    <string name="tour_step_novel_library_body">Giữ truyện này trong thư viện để theo dõi chương mới và tiến độ đọc.</string>
    <string name="tour_step_novel_notifications_title">Chương mới</string>
    <string name="tour_step_novel_notifications_body">Với truyện trong thư viện, chọn nhận thông báo hoặc tự động tải xuống khi có chương mới.</string>
    <string name="tour_step_novel_downloads_title">Đọc ngoại tuyến</string>
    <string name="tour_step_novel_downloads_body">Tải chương xuống để đọc khi không có kết nối.</string>
    <string name="tour_step_novel_chapters_title">Công cụ chương</string>
    <string name="tour_step_novel_chapters_body">Tìm và sắp xếp danh sách chương. Chạm vào số chương để nhảy tới một chương, hoặc nhấn giữ để chọn nhiều chương.</string>
    <string name="tour_step_novel_read_title">Bắt đầu đọc</string>
    <string name="tour_step_novel_read_body">Bắt đầu từ chương đầu tiên, hoặc đọc tiếp từ chỗ bạn dừng lại.</string>
    <string name="tour_reader_title">Hướng dẫn trình đọc</string>
    <string name="tour_reader_description">Điều khiển trình đọc, giao diện và đọc to.</string>
    <string name="tour_reader_hint">Bắt đầu vào lần tới bạn mở một chương</string>
    <string name="tour_step_reader_tap_title">Hiện điều khiển</string>
    <string name="tour_step_reader_tap_body">Chạm vào trang để hiện hoặc ẩn điều khiển trình đọc. Thử ngay nhé.</string>
    <string name="tour_step_reader_settings_title">Tùy chỉnh theo ý bạn</string>
    <string name="tour_step_reader_settings_body">Đổi phông chữ, cỡ chữ, giãn cách, màu sắc và nhiều hơn nữa.</string>
    <string name="tour_step_reader_read_aloud_title">Đọc to</string>
    <string name="tour_step_reader_read_aloud_body">Nghe chương bằng tính năng chuyển văn bản thành giọng nói.</string>
    <string name="tour_step_reader_chapters_title">Chương tiếp theo</string>
    <string name="tour_step_reader_chapters_body">Chuyển sang chương tiếp theo ở đây, hoặc quay lại bằng nút ở đầu bên kia.</string>
    <string name="tour_step_reader_mark_read_title">Đánh dấu đã đọc</string>
    <string name="tour_step_reader_mark_read_body">Đánh dấu chương này là đã đọc hoặc chưa đọc.</string>
    <string name="tour_step_reader_webview_title">Trang gốc</string>
    <string name="tour_step_reader_webview_body">Mở chương trên trang web của nguồn — tiện khi cần đăng nhập, giải captcha hoặc khi chương không tải được.</string>

