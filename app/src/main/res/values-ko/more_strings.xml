    <string name="tour_start">시작</string>
    <string name="tour_progress">%1$d/%2$d</string>
    <string name="tour_welcome_title">시작 둘러보기</string>
    <string name="tour_welcome_description">핵심 기능: 서재, 탐색, 소스, 설정</string>
    <string name="tour_step_welcome_title">Grimoire에 오신 것을 환영해요</string>
    <string name="tour_step_welcome_body">핵심 기능을 빠르게 둘러볼게요. 20초 정도 걸려요.</string>
    <string name="tour_step_library_title">내 서재</string>
    <string name="tour_step_library_body">추가한 소설은 여기에 카테고리별로 정리돼요.</string>
    <string name="tour_step_browse_title">탐색</string>
    <string name="tour_step_browse_body">탐색을 탭하면 여러 소스에서 소설을 찾을 수 있어요.</string>
    <string name="tour_step_extensions_title">소스 및 확장 기능</string>
    <string name="tour_step_extensions_body">소스는 여기서 설치해요. 열어서 어떤 소스가 있는지 확인해 보세요.</string>
    <string name="tour_open_extensions">확장 기능 열기</string>
    <string name="tour_step_repositories_title">저장소</string>
    <string name="tour_step_repositories_body">소스는 저장소에서 제공돼요. 공식 저장소는 이미 추가되어 있어요. 여기를 탭해서 저장소를 관리하거나 직접 추가하세요.</string>
    <string name="tour_step_more_title">그 밖의 모든 것</string>
    <string name="tour_step_more_body">다운로드, 통계, 백업, 설정은 더보기에 있어요.</string>
    <string name="tour_step_done_title">준비가 끝났어요</string>
    <string name="tour_step_done_body">둘러보기는 더보기 → 둘러보기에서 언제든 다시 볼 수 있어요.</string>
    <string name="tour_library_title">서재 둘러보기</string>
    <string name="tour_library_description">검색, 필터, 카테고리, 일괄 작업</string>
    <string name="tour_step_library_find_title">찾기 및 필터</string>
    <string name="tour_step_library_find_body">서재를 검색하거나 상태, 소스, 평점 등으로 정렬하고 필터링하세요.</string>
    <string name="tour_step_library_refresh_title">새 챕터 확인</string>
    <string name="tour_step_library_refresh_body">서재 전체 또는 보고 있는 카테고리만 새로고침해요.</string>
    <string name="tour_step_library_menu_title">카테고리 및 가져오기</string>
    <string name="tour_step_library_menu_body">여기서 카테고리를 만들고 스와이프해서 이동하세요. EPUB 파일도 가져올 수 있어요.</string>
    <string name="tour_step_library_select_title">여러 개 선택</string>
    <string name="tour_step_library_select_body">소설을 길게 눌러 선택을 시작한 다음, 한 번에 이동, 다운로드, 삭제할 수 있어요.</string>
    <string name="tour_browse_title">탐색 둘러보기</string>
    <string name="tour_browse_description">소스, 전체 검색, 필터, NovelUpdates</string>
    <string name="tour_step_browse_sources_title">내 소스</string>
    <string name="tour_step_browse_sources_body">설치한 소스가 언어별로 표시돼요. 탭해서 탐색하고, 길게 눌러 고정하거나 제거하세요.</string>
    <string name="tour_step_browse_search_title">어디서나 검색</string>
    <string name="tour_step_browse_search_body">모든 소스를 한 번에 검색해요.</string>
    <string name="tour_step_browse_filter_title">소스 필터</string>
    <string name="tour_step_browse_filter_body">이름이나 언어로 목록을 좁혀요.</string>
    <string name="tour_step_browse_novelupdates_title">NovelUpdates</string>
    <string name="tour_step_browse_novelupdates_body">NovelUpdates 랭킹, 최신 릴리스, 검색으로 소설을 찾아보세요. 이 섹션은 탐색 설정에서 숨길 수 있어요.</string>
    <string name="tour_step_browse_extensions_title">확장 기능 관리</string>
    <string name="tour_step_browse_extensions_body">소스를 설치, 업데이트, 제거해요. 업데이트가 있으면 여기에 배지가 표시돼요.</string>
    <string name="tour_novel_title">소설 페이지 둘러보기</string>
    <string name="tour_novel_description">서재, 새 챕터 알림, 다운로드, 챕터 도구</string>
    <string name="tour_novel_hint">다음에 소설을 열면 시작돼요</string>
    <string name="tour_step_novel_library_title">서재에 추가</string>
    <string name="tour_step_novel_library_body">이 소설을 서재에 두면 새 챕터와 읽기 진행 상황을 확인할 수 있어요.</string>
    <string name="tour_step_novel_notifications_title">새 챕터</string>
    <string name="tour_step_novel_notifications_body">서재에 있는 소설은 새 챕터를 알림으로 받을지, 자동으로 다운로드할지 선택할 수 있어요.</string>
    <string name="tour_step_novel_downloads_title">오프라인으로 읽기</string>
    <string name="tour_step_novel_downloads_body">챕터를 다운로드하면 인터넷 연결 없이 읽을 수 있어요.</string>
    <string name="tour_step_novel_chapters_title">챕터 도구</string>
    <string name="tour_step_novel_chapters_body">챕터 목록을 검색하고 정렬하세요. 챕터 수를 탭하면 원하는 챕터로 이동하고, 챕터를 길게 누르면 여러 개를 선택할 수 있어요.</string>
    <string name="tour_step_novel_read_title">읽기 시작</string>
    <string name="tour_step_novel_read_body">첫 챕터부터 읽거나, 마지막으로 읽던 곳에서 이어 읽으세요.</string>
    <string name="tour_reader_title">뷰어 둘러보기</string>
    <string name="tour_reader_description">뷰어 컨트롤, 화면 설정, 읽어주기</string>
    <string name="tour_reader_hint">다음에 챕터를 열면 시작돼요</string>
    <string name="tour_step_reader_tap_title">컨트롤 표시</string>
    <string name="tour_step_reader_tap_body">페이지를 탭하면 뷰어 컨트롤을 표시하거나 숨겨요. 지금 해 보세요.</string>
    <string name="tour_step_reader_settings_title">나만의 설정</string>
    <string name="tour_step_reader_settings_body">글꼴, 글자 크기, 간격, 색상 등을 바꿔 보세요.</string>
    <string name="tour_step_reader_read_aloud_title">읽어주기</string>
    <string name="tour_step_reader_read_aloud_body">텍스트 음성 변환으로 챕터를 들어 보세요.</string>
    <string name="tour_step_reader_chapters_title">다음 챕터</string>
    <string name="tour_step_reader_chapters_body">여기서 다음 챕터로 이동하고, 반대쪽 버튼으로 이전 챕터로 돌아가요.</string>
    <string name="tour_step_reader_mark_read_title">읽음으로 표시</string>
    <string name="tour_step_reader_mark_read_body">이 챕터를 읽음 또는 안 읽음으로 표시해요.</string>
    <string name="tour_step_reader_webview_title">원본 페이지</string>
    <string name="tour_step_reader_webview_body">소스 웹사이트에서 챕터를 열어요. 로그인, 캡차, 불러오지 못한 챕터에 유용해요.</string>

