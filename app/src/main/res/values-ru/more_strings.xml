    <string name="tour_start">Начать</string>
    <string name="tour_progress">%1$d/%2$d</string>
    <string name="tour_welcome_title">Знакомство</string>
    <string name="tour_welcome_description">Самое главное: библиотека, обзор, источники и настройки.</string>
    <string name="tour_step_welcome_title">Добро пожаловать в Grimoire</string>
    <string name="tour_step_welcome_body">Короткий обзор самого главного — займёт около 20 секунд.</string>
    <string name="tour_step_library_title">Ваша библиотека</string>
    <string name="tour_step_library_body">Здесь хранятся добавленные новеллы, разложенные по категориям.</string>
    <string name="tour_step_browse_title">Обзор</string>
    <string name="tour_step_browse_body">Нажмите «Обзор», чтобы искать новеллы в ваших источниках.</string>
    <string name="tour_step_extensions_title">Источники и расширения</string>
    <string name="tour_step_extensions_body">Источники устанавливаются отсюда. Откройте, чтобы посмотреть, что доступно.</string>
    <string name="tour_open_extensions">Открыть расширения</string>
    <string name="tour_step_repositories_title">Репозитории</string>
    <string name="tour_step_repositories_body">Источники берутся из репозиториев. Официальный уже добавлен — нажмите здесь, чтобы управлять ими или добавить свой.</string>
    <string name="tour_step_more_title">Всё остальное</string>
    <string name="tour_step_more_body">Загрузки, статистика, резервные копии и настройки находятся в разделе «Ещё».</string>
    <string name="tour_step_done_title">Всё готово</string>
    <string name="tour_step_done_body">Любой тур можно повторить в разделе Ещё → Обучение.</string>
    <string name="tour_library_title">Тур по библиотеке</string>
    <string name="tour_library_description">Поиск, фильтры, категории и массовые действия.</string>
    <string name="tour_step_library_find_title">Поиск и фильтры</string>
    <string name="tour_step_library_find_body">Ищите в библиотеке или сортируйте и фильтруйте её по статусу, источнику, оценке и другим параметрам.</string>
    <string name="tour_step_library_refresh_title">Проверка новых глав</string>
    <string name="tour_step_library_refresh_body">Обновите всю библиотеку или только открытую категорию.</string>
    <string name="tour_step_library_menu_title">Категории и импорт</string>
    <string name="tour_step_library_menu_body">Создавайте здесь категории и переключайтесь между ними свайпом. Также можно импортировать файлы EPUB.</string>
    <string name="tour_step_library_select_title">Выбор нескольких</string>
    <string name="tour_step_library_select_body">Удерживайте новеллу, чтобы начать выбор, а затем переместите, скачайте или удалите все сразу.</string>
    <string name="tour_browse_title">Тур по разделу «Обзор»</string>
    <string name="tour_browse_description">Источники, глобальный поиск, фильтры и NovelUpdates.</string>
    <string name="tour_step_browse_sources_title">Ваши источники</string>
    <string name="tour_step_browse_sources_body">Здесь перечислены установленные источники по языкам. Нажмите на источник, чтобы открыть его; удерживайте, чтобы закрепить или удалить.</string>
    <string name="tour_step_browse_search_title">Поиск везде</string>
    <string name="tour_step_browse_search_body">Ищите по всем источникам сразу.</string>
    <string name="tour_step_browse_filter_title">Фильтр источников</string>
    <string name="tour_step_browse_filter_body">Сузьте список по названию или языку.</string>
    <string name="tour_step_browse_novelupdates_title">NovelUpdates</string>
    <string name="tour_step_browse_novelupdates_body">Находите новеллы через рейтинги, свежие релизы и поиск NovelUpdates. Этот раздел можно скрыть в настройках обзора.</string>
    <string name="tour_step_browse_extensions_title">Управление расширениями</string>
    <string name="tour_step_browse_extensions_body">Устанавливайте, обновляйте и удаляйте источники. Когда есть обновления, здесь появляется значок.</string>
    <string name="tour_novel_title">Тур по странице новеллы</string>
    <string name="tour_novel_description">Библиотека, уведомления о новых главах, загрузки и инструменты глав.</string>
    <string name="tour_novel_hint">Начнётся, когда вы откроете новеллу</string>
    <string name="tour_step_novel_library_title">Добавить в библиотеку</string>
    <string name="tour_step_novel_library_body">Добавьте новеллу в библиотеку, чтобы следить за новыми главами и прогрессом чтения.</string>
    <string name="tour_step_novel_notifications_title">Новые главы</string>
    <string name="tour_step_novel_notifications_body">Для новелл в библиотеке выберите: уведомлять о новых главах или скачивать их автоматически.</string>
    <string name="tour_step_novel_downloads_title">Чтение офлайн</string>
    <string name="tour_step_novel_downloads_body">Скачайте главы, чтобы читать без интернета.</string>
    <string name="tour_step_novel_chapters_title">Инструменты глав</string>
    <string name="tour_step_novel_chapters_body">Ищите и сортируйте список глав. Нажмите на число глав, чтобы перейти к нужной, или удерживайте главы, чтобы выбрать несколько.</string>
    <string name="tour_step_novel_read_title">Начать чтение</string>
    <string name="tour_step_novel_read_body">Начните с первой главы или продолжите с того места, где остановились.</string>
    <string name="tour_reader_title">Тур по читалке</string>
    <string name="tour_reader_description">Управление читалкой, оформление и чтение вслух.</string>
    <string name="tour_reader_hint">Начнётся, когда вы откроете главу</string>
    <string name="tour_step_reader_tap_title">Показать управление</string>
    <string name="tour_step_reader_tap_body">Нажмите на страницу, чтобы показать или скрыть панель управления. Попробуйте сейчас.</string>
    <string name="tour_step_reader_settings_title">Настройте под себя</string>
    <string name="tour_step_reader_settings_body">Меняйте шрифт, размер текста, интервалы, цвета и многое другое.</string>
    <string name="tour_step_reader_read_aloud_title">Читать вслух</string>
    <string name="tour_step_reader_read_aloud_body">Слушайте главу с помощью синтеза речи.</string>
    <string name="tour_step_reader_chapters_title">Следующая глава</string>
    <string name="tour_step_reader_chapters_body">Здесь можно перейти к следующей главе, а кнопкой на другом конце — вернуться назад.</string>
    <string name="tour_step_reader_mark_read_title">Отметить как прочитанную</string>
    <string name="tour_step_reader_mark_read_body">Отметьте эту главу прочитанной или непрочитанной.</string>
    <string name="tour_step_reader_webview_title">Оригинальная страница</string>
    <string name="tour_step_reader_webview_body">Откройте главу на сайте источника — пригодится для входа, капчи или главы, которая не загрузилась.</string>

